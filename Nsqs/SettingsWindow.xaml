<Window x:Class="Nsqs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nsqs"
        Title="{x:Static local:App.SettingsWindowTitle}"
        Width="520"
        Height="720"
        MinWidth="460"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="SettingsCardPanelStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="16,14,16,14"/>
        </Style>

        <Style x:Key="SettingsRowGridStyle" TargetType="Grid">
            <Setter Property="MinHeight" Value="44"/>
        </Style>

        <Style x:Key="SettingsSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
            <Setter Property="Margin" Value="0,10,0,10"/>
        </Style>

        <Style x:Key="SettingsHelpTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}"/>
        </Style>

        <Style x:Key="SettingsSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel Margin="20,20,16,18">

                <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14">
                    <StackPanel Style="{StaticResource SettingsCardPanelStyle}">
                        <TextBlock Text="Network share roots (UNC paths only)" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <ListBox x:Name="ShareRootsList"
                                 MinHeight="100"
                                 MaxHeight="160"
                                 Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewShareText"
                                     Grid.Column="0"
                                     Margin="0,0,8,0"
                                     ToolTip="Example: \\SERVER\Share Name"/>
                            <Button Grid.Column="1" Content="Browse…" Margin="0,0,8,0" Click="BrowseShare_Click"/>
                            <Button Grid.Column="2" Content="Add" Margin="0,0,8,0" Click="AddShare_Click"/>
                            <Button Grid.Column="3" Content="Remove" Click="RemoveShare_Click"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SettingsHelpTextStyle}"
                                   Text="Browse to a network share folder, or paste a UNC path. Mapped drives are converted to UNC automatically."/>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14">
                    <StackPanel Style="{StaticResource SettingsCardPanelStyle}">
                        <Grid Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Launcher hotkey" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="HotkeyText" Grid.Column="1" Width="180" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SettingsHelpTextStyle}"
                                   Text="Format: Ctrl+Shift+Space, Alt+G, etc. Changes apply when you save."/>

                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>

                        <Grid Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Max search results" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="MaxResultsText" Grid.Column="1" Width="80" VerticalAlignment="Center"
                                     ToolTip="1–500 results shown in the launcher"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14">
                    <StackPanel Style="{StaticResource SettingsCardPanelStyle}">
                        <Grid Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Scheduled index rebuild" FontSize="14" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ScheduleEnabledCheck" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>

                        <Grid Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Frequency" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ScheduleKindCombo" Grid.Column="1" Width="170" VerticalAlignment="Center"
                                      SelectionChanged="ScheduleKindCombo_SelectionChanged">
                                <ComboBoxItem Content="Daily"/>
                                <ComboBoxItem Content="Weekly"/>
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>

                        <Grid x:Name="DayOfWeekRow" Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Day of week" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox x:Name="DayOfWeekCombo" Grid.Column="1" Width="170" VerticalAlignment="Center">
                                <ComboBoxItem Content="Sunday"/>
                                <ComboBoxItem Content="Monday"/>
                                <ComboBoxItem Content="Tuesday"/>
                                <ComboBoxItem Content="Wednesday"/>
                                <ComboBoxItem Content="Thursday"/>
                                <ComboBoxItem Content="Friday"/>
                                <ComboBoxItem Content="Saturday"/>
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>

                        <Grid Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Time (local)" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="ScheduleTimeText" Grid.Column="1" Width="100" VerticalAlignment="Center"
                                     ToolTip="24-hour format HH:mm"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>

                        <Grid Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Run missed index on startup" FontSize="14" VerticalAlignment="Center"/>
                            <CheckBox x:Name="RunMissedCheck" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14">
                    <StackPanel Style="{StaticResource SettingsCardPanelStyle}">
                        <TextBlock Text="Index status" Style="{StaticResource SettingsSectionTitleStyle}"/>
                        <TextBlock x:Name="LastIndexedText" TextWrapping="Wrap" FontSize="13"/>
                        <TextBlock x:Name="NextRunText" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"/>
                        <StackPanel x:Name="IndexProgressPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <ProgressBar x:Name="IndexProgressBar"
                                         Height="6"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="IndexProgressText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13"/>
                            <TextBlock x:Name="IndexProgressDetailText" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource SubtleForegroundBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="RebuildButton"
                                    Content="Rebuild index now"
                                    Margin="0,0,8,0"
                                    MinWidth="0"
                                    Click="RebuildButton_Click"/>
                            <Button x:Name="ExportIndexButton"
                                    Content="Export CSV…"
                                    MinWidth="0"
                                    Click="ExportIndexButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,0,0,14">
                    <StackPanel Style="{StaticResource SettingsCardPanelStyle}">
                        <Grid Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="Launch to tray" FontSize="14"/>
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12"
                                           Foreground="{DynamicResource SubtleForegroundBrush}"
                                           Text="When off, the search overlay opens on startup and the app stays on the taskbar."/>
                            </StackPanel>
                            <CheckBox x:Name="LaunchToTrayCheck" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Style="{StaticResource SettingsSeparatorStyle}"/>

                        <Grid Style="{StaticResource SettingsRowGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start with Windows" FontSize="14" VerticalAlignment="Center"/>
                            <CheckBox x:Name="StartWithWindowsCheck" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10,20,18">
            <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="11"
                       Foreground="{DynamicResource SubtleForegroundBrush}"
                       Text="Close keeps the app running. Exit from the tray to quit. Turn off Launch to tray to pin the app to the taskbar."/>
            <Button x:Name="SaveButton" Content="Save" Margin="0,0,8,0" Click="SaveButton_Click"
                    Style="{StaticResource AccentButtonStyle}" IsDefault="True"/>
            <Button Content="Close" Click="CloseButton_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
