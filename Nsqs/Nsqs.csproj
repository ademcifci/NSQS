<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Network Share Quick Search (NSQS)</Product>
    <AssemblyTitle>Network Share Quick Search (NSQS)</AssemblyTitle>
    <AssemblyName>NSQS</AssemblyName>
    <RootNamespace>Nsqs</RootNamespace>
    <NoWarn>WFAC010</NoWarn>
    <Version>1.2.3</Version>
    <ApplicationIcon Condition="Exists('app.ico')">app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nsqs.Tests" />
  </ItemGroup>

</Project>
