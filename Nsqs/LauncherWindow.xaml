<Window x:Class="Nsqs.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nsqs"
        Title="{x:Static local:App.ProductName}"
        Width="680"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="ResultHoverBrush" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="ResultForegroundBrush" Color="White"/>
        <SolidColorBrush x:Key="ResultSubtleBrush" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="LauncherControlBackgroundBrush" Color="#33000000"/>
        <SolidColorBrush x:Key="LauncherControlBorderBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="FilterPillBackgroundBrush" Color="#484848"/>
        <SolidColorBrush x:Key="FilterPillBorderBrush" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="FilterPillForegroundBrush" Color="White"/>
        <SolidColorBrush x:Key="FilterPillRemoveBrush" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="FilterCheckboxBorderBrush" Color="#ADADAD"/>
        <SolidColorBrush x:Key="FilterListFocusBrush" Color="#44FFFFFF"/>
        <SolidColorBrush x:Key="FilterDropdownFocusBrush" Color="#440078D4"/>

        <Style x:Key="FilterPillRemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="7"
                                Width="14"
                                Height="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareFilterCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ResultForegroundBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Box"
                                        Width="16"
                                        Height="16"
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        BorderBrush="{DynamicResource FilterCheckboxBorderBrush}"
                                        Background="{DynamicResource LauncherControlBackgroundBrush}"
                                        Margin="0,0,10,0">
                                    <TextBlock x:Name="CheckMark"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ResultHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShareFilterListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2,0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FilterListFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FilterListFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ResultHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ResultHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ResultHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LauncherFooterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource LauncherControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ResultForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LauncherControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FilterDropdownFocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ResultHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="12"
            Background="#F0202020"
            BorderBrush="#55FFFFFF"
            BorderThickness="1"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="5" Direction="270" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,10">
                <Image x:Name="AppIconImage"
                       Width="22"
                       Height="22"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{x:Static local:App.ProductName}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ResultForegroundBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="2,0,2,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Text="&#xE721;"
                           FontSize="18"
                           Foreground="{DynamicResource ResultSubtleBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="HintText"
                               Text="Search folders..."
                               FontSize="20"
                               Foreground="{DynamicResource ResultSubtleBrush}"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="2,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox x:Name="SearchBox"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="20"
                             Padding="0"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged"
                             PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Margin="2,0,2,10">
                <Border x:Name="FilterDropdown"
                        CornerRadius="6"
                        Padding="6,5"
                        MinHeight="34"
                        MaxHeight="40"
                        Cursor="Hand"
                        Focusable="True"
                        FocusVisualStyle="{x:Null}"
                        PreviewKeyDown="FilterDropdown_PreviewKeyDown"
                        MouseLeftButtonUp="FilterDropdown_MouseLeftButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource LauncherControlBackgroundBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource LauncherControlBorderBrush}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                    <Setter Property="Background" Value="{DynamicResource FilterDropdownFocusBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Text="&#xE968;"
                                   FontSize="12"
                                   Foreground="{DynamicResource ResultSubtleBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FilterPlaceholder"
                                       Text="All network shares"
                                       FontSize="13"
                                       Foreground="{DynamicResource ResultSubtleBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <ScrollViewer x:Name="ShareFilterPillsHost"
                                          Visibility="Collapsed"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PanningMode="HorizontalOnly"
                                          Margin="0,0,4,0">
                                <ItemsControl x:Name="ShareFilterPills">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Tag="ShareFilterPill"
                                                    Height="24"
                                                    Background="{DynamicResource FilterPillBackgroundBrush}"
                                                    BorderBrush="{DynamicResource FilterPillBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="10,0,1,0"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    ClipToBounds="True"
                                                    Focusable="True"
                                                    FocusVisualStyle="{x:Null}"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding RootPath}"
                                                    SnapsToDevicePixels="True"
                                                    MouseLeftButtonUp="ShareFilterPill_MouseLeftButtonUp"
                                                    PreviewKeyDown="ShareFilterPill_PreviewKeyDown">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource FilterPillBorderBrush}"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                <Setter Property="Background" Value="#55FFFFFF"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PillLabel}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource FilterPillForegroundBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,4,0"/>
                                                    <Button Tag="{Binding}"
                                                            Click="ShareFilterPillRemove_Click"
                                                            Style="{StaticResource FilterPillRemoveButtonStyle}"
                                                            ToolTip="Remove filter"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE711;"
                                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="7"
                                                                   Foreground="{DynamicResource FilterPillRemoveBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                        <TextBlock Grid.Column="2"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="9"
                                   Foreground="{DynamicResource ResultSubtleBrush}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,2,0"/>
                    </Grid>
                </Border>

                <Popup x:Name="ShareFilterPopup"
                       PlacementTarget="{Binding ElementName=FilterDropdown}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       PopupAnimation="Fade">
                    <Border Background="#F0202020"
                            BorderBrush="{DynamicResource LauncherControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="6"
                            MinWidth="{Binding ActualWidth, ElementName=FilterDropdown}"
                            MaxHeight="260">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="Black"/>
                        </Border.Effect>
                        <ListBox x:Name="ShareFilterList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="248"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="False"
                                 KeyboardNavigation.DirectionalNavigation="Contained"
                                 ItemContainerStyle="{StaticResource ShareFilterListItemStyle}"
                                 PreviewKeyDown="ShareFilterList_PreviewKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding DisplayName}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource ShareFilterCheckBoxStyle}"
                                              ToolTip="{Binding RootPath}"
                                              Checked="ShareFilter_Changed"
                                              Unchecked="ShareFilter_Changed"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>

            <Border Grid.Row="3" Height="1" Background="#33FFFFFF" Margin="0,0,0,8"/>

            <Grid Grid.Row="4">
                <ListBox x:Name="ResultsList"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ResultItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="ResultsList_MouseDoubleClick"
                         PreviewKeyDown="ResultsList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               Text="&#xE8B7;"
                                               FontSize="14"
                                               Foreground="{DynamicResource ResultSubtleBrush}"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="15"
                                               Foreground="{DynamicResource ResultForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Path}"
                                           FontSize="12"
                                           Foreground="{DynamicResource ResultSubtleBrush}"
                                           Margin="24,2,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyStateText"
                           Text="Type to search indexed folders"
                           FontSize="14"
                           Foreground="{DynamicResource ResultSubtleBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Visible"/>
            </Grid>

            <Grid Grid.Row="5" Margin="2,10,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHintText"
                           Grid.Column="0"
                           Text="↑↓ navigate   Enter open   Esc close   Tab move focus   Space toggle   Ctrl+E export"
                           FontSize="11"
                           Foreground="{DynamicResource ResultSubtleBrush}"/>
                <Button x:Name="ExportResultsButton"
                        Grid.Column="1"
                        Content="Export CSV"
                        Margin="0,0,10,0"
                        Style="{StaticResource LauncherFooterButtonStyle}"
                        Visibility="Collapsed"
                        PreviewKeyDown="ExportResultsButton_PreviewKeyDown"
                        Click="ExportResultsButton_Click"/>
                <TextBlock x:Name="ResultCountText"
                           Grid.Column="2"
                           FontSize="11"
                           Foreground="{DynamicResource ResultSubtleBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
