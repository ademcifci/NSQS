<Window x:Class="Nsqs.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nsqs"
        Title="{x:Static local:App.ProductName}"
        Width="1"
        Height="1"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Left="-32000"
        Top="-32000">
</Window>
